        "options": {},
        "bodyParametersJson": "={\n  \"points\": [\n    {\n      \"id\": \"{{$json[\"file\"]}}\",\n      \"vector\": {{$json[\"embedding\"]}},\n      \"payload\": {\n        \"filename\": \"{{$json[\"file\"]}}\",\n        \"text\": \"{{$json[\"prompt\"]}}\"\n      }\n    }\n  ]\n}\n",
